# Firebase browser configuration (public client values, not server secrets).
# Copy this file to .env.local and fill in values from your Firebase web app.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_MEASUREMENT_ID=
FIREBASE_APP_CHECK_SITE_KEY=
FIREBASE_TRACKING_ENABLED=true
